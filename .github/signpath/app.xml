<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": multipath.exe, before the installer packages it.
     The metadata restrictions are required by SignPath Foundation. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="multipath.exe" product-name="MultiPath" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
